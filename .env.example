# ==========================================
# PEPEA (NG'AMBO) - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Africa's Talking API Credentials
# Sign up at https://africastalking.com/ and create an app in the sandbox or production
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key_here
AT_VIRTUAL_NUMBER=+254711082000
AT_SENDER_ID=PEPEA

# 2. Google Gemini API (Admissions Officer & Mwalimu Recommender)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Supabase Database & Realtime (Optional for Local Mock Mode)
# Create a free project at https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 4. App Base URL (For AT Voice XML and USSD Webhooks)
# When testing locally with ngrok: https://xxxx.ngrok-free.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 5. Presentation Demo Mode (Set to true to provide instant mock responses if keys are omitted)
NEXT_PUBLIC_DEMO_MODE=true
